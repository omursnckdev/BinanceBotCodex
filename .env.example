# ============================================
# Binance Futures Trading Bot Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# === SAFETY TOGGLES (CRITICAL) ===
# Default configuration is SAFE:
# - ENV=testnet (uses Binance Futures testnet)
# - DRY_RUN=true (no real orders)
# - ALLOW_LIVE_TRADING=false (extra safety lock)

# Environment: testnet or mainnet
ENV=testnet

# Dry run mode - no real orders placed when true
DRY_RUN=true

# Extra safety lock - must be true for live trading
ALLOW_LIVE_TRADING=false

# !!! WARNING !!!
# To enable LIVE TRADING with REAL MONEY, you must set ALL THREE:
# ENV=mainnet
# DRY_RUN=false
# ALLOW_LIVE_TRADING=true
# !!! YOU WILL LOSE MONEY IF YOUR STRATEGY IS BAD !!!

# === BINANCE API CREDENTIALS ===
# Get testnet keys from: https://testnet.binancefuture.com/
# Get mainnet keys from: https://www.binance.com/en/my/settings/api-management

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# === NEWS/SENTIMENT API KEYS (Optional) ===
# CryptoPanic: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# NewsAPI: https://newsapi.org/
NEWSAPI_API_KEY=

# === TRADING CONFIGURATION ===
# Comma-separated list of symbols to trade
# TRADING_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# Main loop interval in seconds
# MAIN_LOOP_INTERVAL_SECONDS=5.0

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
LOG_ROTATION_MB=10
LOG_BACKUP_COUNT=5

# === RISK MANAGEMENT ===
# These can be overridden via environment variables
# See config.py for all available options

# RISK__MAX_DAILY_LOSS_PCT=5.0
# RISK__MAX_CONSECUTIVE_LOSSES=5
# RISK__MAX_TOTAL_EXPOSURE_PCT=50.0
# RISK__MAX_OPEN_POSITIONS=3
# RISK__DEFAULT_RISK_PER_TRADE_PCT=1.0

# === DATA CONFIGURATION ===
# DATA__PRIMARY_TIMEFRAME=1m
# DATA__MAX_SPREAD_PCT=0.15
# DATA__MIN_LIQUIDITY_USD=50000

# === FUSION STRATEGY ===
# FUSION__ENTRY_THRESHOLD=0.3
# FUSION__MIN_CONFIDENCE_FOR_ENTRY=0.4
